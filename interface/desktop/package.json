{
  "name": "memoria-control-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Memoria 的 Web 桌面端：多窗口监控内核、训练、中继与错误码。",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../ops/scripts/build-installer.ps1"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cn.mrhua.memoria",
    "productName": "Memoria Control Desk",
    "asar": false,
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main.js",
      "package.json",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web"
      },
      {
        "from": "../../archive/backend-python/monitor/dist/memoria-monitor.exe",
        "to": "monitor/memoria-monitor.exe"
      },
      {
        "from": "../../command/relay/dist/memoria-relay.exe",
        "to": "relay/memoria-relay.exe"
      },
      {
        "from": "../../src/kernel/host/bridge/dist/memoria-bridge.exe",
        "to": "bridge/memoria-bridge.exe"
      },
      {
        "from": "../../build/memoria_gen_cpu.exe",
        "to": "build/memoria_gen_cpu.exe"
      },
      {
        "from": "../../build/checkpoint_aevum_shakespeare",
        "to": "build/checkpoint_aevum_shakespeare"
      },
      {
        "from": "../../build/training_metrics.jsonl",
        "to": "build/training_metrics.jsonl"
      },
      {
        "from": "../../src/kernel/host/console/disk.img",
        "to": "kernel/disk.img"
      },
      {
        "from": "../../command/relay/contracts/errors.json",
        "to": "contracts/errors.json"
      },
      {
        "from": "../../data/tinyshakespeare_3000.txt",
        "to": "data/tinyshakespeare_3000.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../web/assets/favicon-256.ico",
      "compression": "store"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Memoria Control Desk",
      "installerIcon": "../web/assets/favicon-256.ico",
      "uninstallerIcon": "../web/assets/favicon-256.ico",
      "artifactName": "Memoria-Control-Desk-Setup-${version}.${ext}"
    }
  }
}
