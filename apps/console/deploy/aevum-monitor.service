[Unit]
Description=Aevum desktop monitor, identity API and model generator
After=network-online.target aevum-relay.service aevum-bridge.service
Wants=network-online.target
Wants=aevum-relay.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=@APP_ROOT@/src
Environment=MEMORIA_ROOT=@APP_ROOT@
Environment=MEMORIA_WEB_ROOT=@WEB_ROOT@
Environment=MEMORIA_ERROR_TABLE=@APP_ROOT@/apps/relay/contracts/errors.json
Environment=MEMORIA_BUILD_ROOT=@APP_ROOT@/build
Environment=MEMORIA_TORCH_LIB=@TORCH_LIB@
WorkingDirectory=@APP_ROOT@/apps/console/monitor
ExecStart=@PYTHON@ desktop_server.py --host 127.0.0.1 --port 8781 --relay-port 8790 --bridge-port 8765 --serial-port 5555 --metrics @APP_ROOT@/build/linux/training_metrics.jsonl --model-exe @APP_ROOT@/build/linux/memoria_gen_cpu --model-exe-cuda @APP_ROOT@/build/linux/memoria_gen --model-data @APP_ROOT@/data/tinyshakespeare_3000.txt
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
